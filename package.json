{
  "name": "eny-salon",
  "version": "2.0.0",
  "private": true,
  "description": "Restored salon coursework with an isolated persistent demo workspace",
  "main": "azure/functions.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "test": "node --test",
    "demo:local": "node scripts/local-demo.js",
    "db:prepare": "node scripts/prepare-db.js",
    "db:cleanup": "node scripts/cleanup.js",
    "package:azure": "node scripts/package-azure.js"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "mongodb": "7.7.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.2.2"
  }
}
