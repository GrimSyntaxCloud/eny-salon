<% const data={...(appointment||{}),...values}; %>
<div class="form-grid"><% for(const [key,label,type,max] of [['name','Your name','text',100],['email','Email address','email',200],['address','Street address','text',200],['city','City','text',100],['state','State · two letters','text',2],['zip','ZIP code','text',10]]) { %><label><%= label %><input name="<%= key %>" type="<%= type %>" maxlength="<%= max %>" required value="<%= data[key]||'' %>"></label><% } %></div>
<label>Haircare service<select name="service" required><% for(const [name,price] of Object.entries(SERVICES)){ %><option value="<%= name %>" <%= data.service===name?'selected':'' %>><%= name %> · $<%= price.toFixed(2) %></option><% } %></select></label>
<fieldset><legend>A little extra care</legend><% for(const extra of EXTRAS){ %><label class="check"><input type="checkbox" name="extras" value="<%= extra %>" <%= (Array.isArray(data.extras)?data.extras:[]).includes(extra)?'checked':'' %>><%= extra %> · $<%= SERVICES[extra].toFixed(2) %></label><% } %></fieldset>
